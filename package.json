{
  "name": "menhera-chan-bot",
  "version": "2.0.0",
  "description": "Menhera-Chan Discord Bot - A multi-purpose Discord bot with moderation, music, roleplay, and more features",
  "main": "src/bot.js",
  "type": "module",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "node --watch src/bot.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "discord",
    "bot",
    "music",
    "moderation",
    "roleplay",
    "anime"
  ],
  "author": "OpenianDevelopment",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.16.0",
    "ascii-table": "^0.0.9",
    "axios": "^1.7.0",
    "bufferutil": "^4.0.8",
    "canvas": "^2.11.2",
    "common-tags": "^1.8.2",
    "connect-mongo": "^5.1.0",
    "connect-redis": "^7.1.1",
    "cross-fetch": "^4.0.0",
    "crypto-js": "^4.2.0",
    "discord-webhook-messages": "^1.0.1",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.0",
    "ejs": "^3.1.9",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "humanize-duration": "^3.31.0",
    "ioredis": "^5.3.2",
    "jikanjs": "^0.7.0",
    "libsodium-wrappers": "^0.7.13",
    "lyrics-finder": "^21.7.0",
    "method-override": "^3.0.0",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "mongoose": "^8.2.0",
    "ms": "^2.1.3",
    "opusscript": "^0.1.1",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "pc-stats": "^0.0.7",
    "random-puppy": "^1.1.0",
    "redis": "^4.6.13",
    "reddit-image-fetcher": "^2.0.12",
    "short-string-number": "^1.0.1",
    "simple-youtube-api": "^5.2.1",
    "soundcloud-downloader": "^1.0.0",
    "spdl-core": "^2.0.2",
    "string-progressbar": "^1.0.4",
    "utf-8-validate": "^6.0.3",
    "winston": "^3.12.0",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5",
    "zlib-sync": "^0.1.9"
